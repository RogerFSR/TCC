<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:cardBackgroundColor="#2C2C2C"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

        <TextView
                android:id="@+id/nomeFornecedor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Nome do Fornecedor"
                android:textColor="#FFD700"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        <TextView
                android:id="@+id/telFornecedor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Telefone: (00) 00000-0000"
                android:textColor="#CCCCCC"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@id/nomeFornecedor"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        <TextView
                android:id="@+id/cidadeFornecedor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Cidade: Exemplo"
                android:textColor="#CCCCCC"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@id/telFornecedor"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                app:layout_constraintTop_toBottomOf="@id/cidadeFornecedor"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

            <Button
                    android:id="@+id/btnEditarFornecedor"
                    android:layout_width="120dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:text="Editar"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#1976D2" />

            <Button
                    android:id="@+id/btnExcluirFornecedor"
                    android:layout_width="120dp"
                    android:layout_height="40dp"
                    android:text="Excluir"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#D32F2F" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
