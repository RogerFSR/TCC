<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#2C2C2C">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

        <TextView
                android:id="@+id/txtNomeVendaItem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Nome Produto"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
                android:id="@+id/txtDetalheVendaItem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="1 x R$ 9,99 = R$ 9,99"
                android:textColor="#CCCCCC"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@id/txtNomeVendaItem"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="6dp"/>

        <!-- Botão EDITAR / adicionar -->
        <Button
                android:id="@+id/btnAddQuantidade"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="+"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2962FF"
                app:layout_constraintTop_toBottomOf="@id/txtDetalheVendaItem"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"/>

        <!-- Botão EXCLUIR / remover -->
        <Button
                android:id="@+id/btnRemoveQuantidade"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="-"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#F44336"
                app:layout_constraintTop_toBottomOf="@id/txtDetalheVendaItem"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="8dp"
                android:layout_marginStart="8dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
