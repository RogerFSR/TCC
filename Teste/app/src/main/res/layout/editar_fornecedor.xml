<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:background="#1C1C1C"
        tools:context=".EditarFornecedorActivity">

    <!-- Título -->
    <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Editar Fornecedor"
            android:textSize="20sp"
            android:textColor="#C31717"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    <!-- CNPJ -->
    <com.santalu.maskara.widget.MaskEditText
            android:id="@+id/cnpjFornecedor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="CNPJ"
            android:textColor="#FFFFFF"
            android:textColorHint="#B0B0B0"
            android:inputType="number"
            app:mask="##.###.###/####-##"
            app:layout_constraintTop_toBottomOf="@id/title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp"
            android:background="#2C2C2C"
            android:padding="12dp"
            android:enabled="false"/> <!-- CNPJ não editável -->

    <!-- Nome -->
    <EditText
            android:id="@+id/nomeFornecedor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Nome do fornecedor"
            android:textColor="#FFFFFF"
            android:textColorHint="#B0B0B0"
            android:inputType="textPersonName"
            app:layout_constraintTop_toBottomOf="@id/cnpjFornecedor"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"
            android:background="#2C2C2C"
            android:padding="12dp"/>

    <!-- Telefone -->
    <com.santalu.maskara.widget.MaskEditText
            android:id="@+id/telFornecedor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Telefone"
            android:textColor="#FFFFFF"
            android:textColorHint="#B0B0B0"
            android:inputType="phone"
            app:mask="(##) #####-####"
            app:layout_constraintTop_toBottomOf="@id/nomeFornecedor"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"
            android:background="#2C2C2C"
            android:padding="12dp"/>

    <!-- E-mail -->
    <EditText
            android:id="@+id/emailFornecedor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="E-mail"
            android:textColor="#FFFFFF"
            android:textColorHint="#B0B0B0"
            android:inputType="textEmailAddress"
            app:layout_constraintTop_toBottomOf="@id/telFornecedor"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"
            android:background="#2C2C2C"
            android:padding="12dp"/>

    <!-- CEP -->
    <com.santalu.maskara.widget.MaskEditText
            android:id="@+id/cepFornecedor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="CEP"
            android:textColor="#FFFFFF"
            android:textColorHint="#B0B0B0"
            android:inputType="number"
            app:mask="#####-###"
            app:layout_constraintTop_toBottomOf="@id/emailFornecedor"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"
            android:background="#2C2C2C"
            android:padding="12dp"/>

    <!-- Endereço -->
    <EditText
            android:id="@+id/endFornecedor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Endereço"
            android:textColor="#FFFFFF"
            android:textColorHint="#B0B0B0"
            android:inputType="textPostalAddress"
            app:layout_constraintTop_toBottomOf="@id/cepFornecedor"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"
            android:background="#2C2C2C"
            android:padding="12dp"/>

    <!-- Bairro -->
    <EditText
            android:id="@+id/bairroFornecedor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Bairro"
            android:textColor="#FFFFFF"
            android:textColorHint="#B0B0B0"
            app:layout_constraintTop_toBottomOf="@id/endFornecedor"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"
            android:background="#2C2C2C"
            android:padding="12dp"/>

    <!-- Cidade -->
    <EditText
            android:id="@+id/cidadeFornecedor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Cidade"
            android:textColor="#FFFFFF"
            android:textColorHint="#B0B0B0"
            app:layout_constraintTop_toBottomOf="@id/bairroFornecedor"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"
            android:background="#2C2C2C"
            android:padding="12dp"/>

    <!-- Estado -->
    <EditText
            android:id="@+id/estadoFornecedor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Estado"
            android:textColor="#FFFFFF"
            android:textColorHint="#B0B0B0"
            android:inputType="text"
            app:layout_constraintTop_toBottomOf="@id/cidadeFornecedor"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp"
            android:background="#2C2C2C"
            android:padding="12dp"/>

    <!-- Botões -->
    <Button
            android:id="@+id/btnSalvarFornecedor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Salvar"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFF"
            app:layout_constraintTop_toBottomOf="@id/estadoFornecedor"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnVoltarFornecedor"
            app:layout_constraintWidth_percent="0.45"
            android:layout_marginTop="12dp"/>

    <Button
            android:id="@+id/btnVoltarFornecedor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Voltar"
            android:backgroundTint="#F44336"
            android:textColor="#FFF"
            app:layout_constraintTop_toBottomOf="@id/estadoFornecedor"
            app:layout_constraintStart_toEndOf="@id/btnSalvarFornecedor"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_percent="0.45"
            android:layout_marginTop="12dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
