<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#1C1C1C"
    tools:context=".NovoClienteActivity">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dados do cliente"
        android:textSize="20sp"
        android:textColor="#C31717"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- CPF com máscara -->
    <com.santalu.maskara.widget.MaskEditText
        android:id="@+id/cpfCliente"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="CPF"
        android:textColor="#FFFFFF"
        android:textColorHint="#B0B0B0"
        android:inputType="number"
        app:mask="###.###.###-##"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"
        android:background="#2C2C2C"
        android:padding="12dp"/>

    <!-- Nome -->
    <EditText
        android:id="@+id/nomeCliente"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Nome"
        android:textColor="#FFFFFF"
        android:textColorHint="#B0B0B0"
        android:inputType="textPersonName"
        app:layout_constraintTop_toBottomOf="@id/cpfCliente"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"
        android:background="#2C2C2C"
        android:padding="12dp"/>

    <!-- Telefone 1 -->
    <com.santalu.maskara.widget.MaskEditText
        android:id="@+id/telClienteText8"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Telefone"
        android:textColor="#FFFFFF"
        android:textColorHint="#B0B0B0"
        android:inputType="phone"
        app:mask="(##) #####-####"
        app:layout_constraintTop_toBottomOf="@id/nomeCliente"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"
        android:background="#2C2C2C"
        android:padding="12dp"/>

    <!-- Telefone 2 -->
    <com.santalu.maskara.widget.MaskEditText
        android:id="@+id/telCliente2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Telefone 2 (opcional)"
        android:textColor="#FFFFFF"
        android:textColorHint="#B0B0B0"
        android:inputType="phone"
        app:mask="(##) #####-####"
        app:layout_constraintTop_toBottomOf="@id/telClienteText8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"
        android:background="#2C2C2C"
        android:padding="12dp"/>

    <!-- CEP -->
    <com.santalu.maskara.widget.MaskEditText
        android:id="@+id/cepCliente"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="CEP"
        android:textColor="#FFFFFF"
        android:textColorHint="#B0B0B0"
        android:inputType="number"
        app:mask="#####-###"
        app:layout_constraintTop_toBottomOf="@id/telCliente2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"
        android:background="#2C2C2C"
        android:padding="12dp"/>

    <!-- Endereço / Bairro / Cidade / E-mail -->
    <EditText
        android:id="@+id/endCliente"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Endereço"
        android:textColor="#FFFFFF"
        android:textColorHint="#B0B0B0"
        android:inputType="text"
        app:layout_constraintTop_toBottomOf="@id/cepCliente"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"
        android:background="#2C2C2C"
        android:padding="12dp"/>

    <EditText
        android:id="@+id/bairroCliente"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Bairro"
        android:textColor="#FFFFFF"
        android:textColorHint="#B0B0B0"
        android:inputType="text"
        app:layout_constraintTop_toBottomOf="@id/endCliente"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"
        android:background="#2C2C2C"
        android:padding="12dp"/>

    <EditText
        android:id="@+id/cidCliente"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Cidade"
        android:textColor="#FFFFFF"
        android:textColorHint="#B0B0B0"
        android:inputType="text"
        app:layout_constraintTop_toBottomOf="@id/bairroCliente"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"
        android:background="#2C2C2C"
        android:padding="12dp"/>

    <EditText
        android:id="@+id/emailCliente"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="E-mail"
        android:textColor="#FFFFFF"
        android:textColorHint="#B0B0B0"
        android:inputType="textEmailAddress"
        app:layout_constraintTop_toBottomOf="@id/cidCliente"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"
        android:background="#2C2C2C"
        android:padding="12dp"/>

    <!-- Botões Salvar / Voltar -->
    <Button
        android:id="@+id/btnSalvarCliente"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Salvar"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFF"
        app:layout_constraintTop_toBottomOf="@id/emailCliente"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/voltar_btn"
        app:layout_constraintWidth_percent="0.45"
        android:layout_marginTop="12dp"/>

    <Button
        android:id="@+id/voltar_btn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Voltar"
        android:backgroundTint="#F44336"
        android:textColor="#FFF"
        app:layout_constraintTop_toBottomOf="@id/emailCliente"
        app:layout_constraintStart_toEndOf="@id/btnSalvarCliente"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_percent="0.45"
        android:layout_marginTop="12dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
