<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:background="#1C1C1C">

    <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Editar Tipo"
            android:textSize="20sp"
            android:textColor="#C31717"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

    <EditText
            android:id="@+id/codTipoEdit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Código"
            android:textColor="#FFFFFF"
            android:textColorHint="#B0B0B0"
            android:enabled="false"
            android:background="#2C2C2C"
            android:padding="12dp"
            app:layout_constraintTop_toBottomOf="@id/title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp"/>

    <EditText
            android:id="@+id/descricaoTipoEdit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Descrição do tipo"
            android:textColor="#FFFFFF"
            android:textColorHint="#B0B0B0"
            android:background="#2C2C2C"
            android:padding="12dp"
            app:layout_constraintTop_toBottomOf="@id/codTipoEdit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp"/>

    <Button
            android:id="@+id/btnSalvarTipoEdit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Salvar"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFF"
            app:layout_constraintTop_toBottomOf="@id/descricaoTipoEdit"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnVoltarEdit"
            app:layout_constraintWidth_percent="0.45"
            android:layout_marginTop="12dp"/>

    <Button
            android:id="@+id/btnVoltarEdit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Voltar"
            android:backgroundTint="#F44336"
            android:textColor="#FFF"
            app:layout_constraintTop_toBottomOf="@id/descricaoTipoEdit"
            app:layout_constraintStart_toEndOf="@id/btnSalvarTipoEdit"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_percent="0.45"
            android:layout_marginTop="12dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
