<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101010"
    tools:context=".MainActivity">

    <!-- Guideline central -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5" />

    <!-- Coluna esquerda -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/Registrar_Venda"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="6dp"
        android:text="Registrar Venda"
        android:textColor="@android:color/white"
        app:backgroundTint="#2962FF"
        app:cornerRadius="4dp"
        app:icon="@drawable/registrar_venda"
        app:iconGravity="textTop"
        app:iconSize="48dp"
        app:iconTint="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/listar_clientes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/guideline_vertical" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/listar_clientes"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="12dp"
        android:text="Listar Clientes"
        android:textColor="@android:color/white"
        app:backgroundTint="#00B294"
        app:cornerRadius="4dp"
        app:icon="@drawable/listar_cliente"
        app:iconGravity="textTop"
        app:iconSize="48dp"
        app:iconTint="@android:color/white"
        app:layout_constraintBottom_toTopOf="@id/gerar_recibo"
        app:layout_constraintEnd_toStartOf="@id/guideline_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/Registrar_Venda"/>

    <com.google.android.material.button.MaterialButton
            android:id="@+id/gerar_recibo"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="6dp"
            android:text="Gerar Relatório"
            android:textColor="@android:color/white"
            app:backgroundTint="#107C10"
            app:cornerRadius="4dp"
            app:icon="@drawable/gerar_relatorio"
            app:iconGravity="textTop"
            app:iconSize="48dp"
            app:iconTint="@android:color/white"
            app:layout_constraintTop_toBottomOf="@id/listar_clientes"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/guideline_vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="12dp" />

    <!-- NOVO: Fornecedores -->

    <!-- Coluna direita -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/novo_cliente"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="12dp"
        android:text="Cadastrar Cliente"
        android:textColor="@android:color/white"
        app:icon="@drawable/add_cliente"
        app:iconGravity="textTop"
        app:iconTint="@android:color/white"
        app:iconSize="48dp"
        app:cornerRadius="4dp"
        app:backgroundTint="#FF8C00"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="@id/guideline_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/add_produto"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/add_produto"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="6dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:text="Adicionar Produto"
        android:textColor="@android:color/white"
        app:backgroundTint="#E81123"
        app:cornerRadius="4dp"
        app:icon="@drawable/add_prod"
        app:iconGravity="textTop"
        app:iconSize="48dp"
        app:iconTint="@android:color/white"
        app:layout_constraintBottom_toTopOf="@id/cadastrar_func"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/guideline_vertical"
        app:layout_constraintTop_toBottomOf="@id/novo_cliente"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/cadastrar_func"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="12dp"
        android:text="Cadastrar Funcionário"
        android:textColor="@android:color/white"
        app:icon="@drawable/add_func"
        app:iconGravity="textTop"
        app:iconTint="@android:color/white"
        app:iconSize="48dp"
        app:cornerRadius="4dp"
        app:backgroundTint="#6B69D6"
        app:layout_constraintTop_toBottomOf="@id/add_produto"
        app:layout_constraintBottom_toTopOf="@id/listar_funcs"
        app:layout_constraintStart_toStartOf="@id/guideline_vertical"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.button.MaterialButton
            android:id="@+id/listar_funcs"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="6dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:text="Listar Funcionários"
            android:textColor="@android:color/white"
            app:backgroundTint="#D669D4"
            app:cornerRadius="4dp"
            app:icon="@drawable/listar_func"
            app:iconGravity="textTop"
            app:iconSize="48dp"
            app:iconTint="@android:color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/guideline_vertical"
            app:layout_constraintTop_toBottomOf="@id/cadastrar_func"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="12dp" />

    <!-- Consultar Estoque -->

</androidx.constraintlayout.widget.ConstraintLayout>
