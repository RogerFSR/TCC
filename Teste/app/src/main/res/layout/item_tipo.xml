<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:cardBackgroundColor="#2C2C2C"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

        <TextView
                android:id="@+id/codTipo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Código: 1"
                android:textColor="#FFD700"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        <TextView
                android:id="@+id/descricaoTipo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Descrição: Bebida"
                android:textColor="#CCCCCC"
                android:textSize="16sp"
                app:layout_constraintTop_toBottomOf="@id/codTipo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                app:layout_constraintTop_toBottomOf="@id/descricaoTipo"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginEnd="8dp">

            <Button
                    android:id="@+id/btnExcluirTipo"
                    android:layout_width="120dp"
                    android:layout_height="40dp"
                    android:text="Excluir"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#D32F2F" />
        </LinearLayout>

        <Button
                android:id="@+id/btnEditarTipo"
                android:layout_width="120dp"
                android:layout_height="40dp"
                android:text="Editar"
                android:textColor="#FFFFFF"
                android:backgroundTint="#1976D2"
                tools:layout_editor_absoluteY="62dp"
                app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
