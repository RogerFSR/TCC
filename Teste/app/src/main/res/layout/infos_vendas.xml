<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#1C1C1C">

    <!-- Título ID do Funcionário -->
    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ID do funcionário:"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Input ID do Funcionário -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutIdFunc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/textView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxStrokeColor="#2962FF">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/IdFunc_txtBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Digite o ID"
            android:inputType="text"
            android:textColor="#FFFFFF"
            android:textColorHint="#B0B0B0"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Título CPF do Cliente -->
    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CPF do cliente:"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/layoutIdFunc"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Input CPF do Cliente -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layoutCpfCliente"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/textView2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:boxBackgroundMode="outline"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxStrokeColor="#2962FF">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/idFunc_txtBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Digite o CPF"
            android:inputType="text"
            android:textColor="#FFFFFF"
            android:textColorHint="#B0B0B0"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Botão Cadastrar Cliente -->
    <Button
        android:id="@+id/cadastrar_cliente"
        android:layout_width="250dp"
        android:layout_height="50dp"
        android:layout_marginStart="5dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#2962FF"
        android:clipToOutline="true"
        android:text="Cadastrar cliente"
        android:textColor="#FFFFFF"
        app:cornerRadius="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutCpfCliente" />

    <!-- Botão Confirmar / Próximo -->
    <Button
        android:id="@+id/button2"
        android:layout_width="180dp"
        android:layout_height="50dp"
        android:layout_marginStart="5dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#388E3C"
        android:clipToOutline="true"
        android:text="Confirmar"
        android:textColor="#FFFFFF"
        app:cornerRadius="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cadastrar_cliente" />

    <!-- Botão Voltar -->
    <Button
        android:id="@+id/Voltar_main"
        android:layout_width="175dp"
        android:layout_height="50dp"
        android:layout_marginBottom="10dp"
        android:backgroundTint="#D32F2F"
        android:clipToOutline="true"
        android:text="Voltar"
        android:textColor="#FFFFFF"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
